root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.vue]
indent_size = 2

[*.ts]
indent_size = 2

[*.js]
indent_size = 2

[*.css]
indent_size = 2

[*.scss]
indent_size = 2

[*.sql]
indent_size = 2

[*.java]
indent_size = 4