# Internet Archaeology Museum — Environment Variables
# Copy this file to .env and fill in the values.
# 将此文件复制为 .env 并填写对应的值。
#
# IMPORTANT: Never commit .env to version control.
# 重要：不要将 .env 提交到版本控制。

# -------------------------------------------------------
# Database / 数据库
# -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=museum
DB_USERNAME=museum_user
DB_PASSWORD=museum_pass

# MySQL root password (used by Docker only)
# 仅 Docker 使用
MYSQL_ROOT_PASSWORD=root_change_me

# -------------------------------------------------------
# Redis
# -------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no password (dev). Set for production.
# 开发环境可留空，生产环境必须设置。
REDIS_PASSWORD=

# -------------------------------------------------------
# JWT
# -------------------------------------------------------
# Must be a long random string in production.
# 生产环境必须替换为长随机字符串。
JWT_SECRET=change-this-to-a-long-random-secret-in-production-please
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7
